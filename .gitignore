# SSH / private keys -- never commit these
*.pem
*.key
*.csv

# Secrets / local config -- never commit (holds DB creds, e.g. RDS password)
.env

# Python
__pycache__/
*.pyc

# Personal re-understanding aids (study notes, not project docs)
docs/REVISION.md
docs/REVISION-ANSWERS.md

# Local sanity-test outputs (large, regenerable)
sanity/track/
sanity/track_out/
sanity/frames/
sanity/frames2/
sanity/typeset/
sanity/crops/
