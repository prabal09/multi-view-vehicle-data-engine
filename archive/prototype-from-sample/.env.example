# Copy to .env and fill in. The loader/CLI read DATABASE_URL (a libpq/psycopg
# connection string). Works for local Docker Postgres and AWS RDS alike.

# Local docker-compose Postgres (see docker-compose.yml):
DATABASE_URL=postgresql://vehicle:vehicle@localhost:5432/vehicles

# AWS RDS for PostgreSQL example (require SSL):
# DATABASE_URL=postgresql://USER:PASSWORD@your-instance.abcdef.us-east-1.rds.amazonaws.com:5432/vehicles?sslmode=require
